      "lemmatizer": "simplemma cs, en"
    },
    "strategy": {
      "sources": [
        "lexical",
        "semantic"
      ],
      "fusion": "rrf",
      "k": 60,
      "chunk_pool": 200
    },
    "reranking": null,
    "aggregation": {
      "method": "best chunk"
    }
  },
